# Mizrahi Special Transactions - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# TASE DataWise API Key (required for CHK_7 - Problematic Securities Check)
# Obtain from: https://datawise.tase.co.il
TASE_API_KEY=your_tase_api_key_here

# Apify API Token (required for batch processing)
# Obtain from: https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Resend API Key (required for email sending)
# Obtain from: https://resend.com/api-keys
# Note: Requires verified sender domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
