    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst fullPath = $('Get Output Excel Path').first().json.stdout.trim();\nconst fileName = fullPath.split('/').pop();\n\n// Get form data\nconst formData = $('Extract Form Data').first().json;\n\n// Parse email JSON for transaction samples\nlet emailJsonStr = $('Get Email JSON').first().json.stdout || '[]';\nlet transactionSamples = [];\ntry {\n  transactionSamples = JSON.parse(emailJsonStr);\n} catch (e) {\n  transactionSamples = [];\n}\n\n// Update binary filename\nif (item.binary && item.binary.data) {\n  item.binary.data.fileName = fileName;\n}\n\n// Add all data to json for next nodes\nitem.json.managerName = formData.managerName;\nitem.json.emails = formData.emails;\nitem.json.fileName = fileName;\nitem.json.transactionSamples = transactionSamples;\nitem.json.timestamp = formData.timestamp;\n\nreturn [item];"
      },
