    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"he\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>דוח עסקאות מיוחדות</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f6f8; direction: rtl; line-height: 1.7;\">\n    \n    <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color: #f4f6f8; padding: 40px 20px;\">\n        <tr>\n            <td align=\"center\">\n                \n                <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"max-width: 600px; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06); overflow: hidden;\">\n                    \n                    <!-- Header -->\n                    <tr>\n                        <td style=\"background-color: #ffffff; padding: 30px 40px; border-bottom: 1px solid #eef1f4; text-align: center;\">\n                            <img src=\"https://storage.bhol.co.il/articles/35167_tumb_700X500.png\" alt=\"מזרחי טפחות\" style=\"max-height: 100px; max-width: 420px;\">\n                        </td>\n                    </tr>\n                    \n                    <!-- Status Banner -->\n                    <tr>\n                        <td style=\"background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%); padding: 45px 40px; text-align: center;\">\n                            <div style=\"width: 70px; height: 70px; background-color: rgba(255,255,255,0.2); border-radius: 50%; margin: 0 auto 20px; line-height: 70px;\">\n                                <span style=\"font-size: 32px; color: white;\">&#128202;</span>\n                            </div>\n                            <h1 style=\"color: #ffffff; margin: 0 0 8px 0; font-size: 24px; font-weight: 600;\">דוח עסקאות מיוחדות</h1>\n                            <p style=\"color: rgba(255,255,255,0.9); margin: 0; font-size: 15px; font-weight: 400;\">בדיקות #1-#7 הושלמו</p>\n                        </td>\n                    </tr>\n                    \n                    <!-- Main Content -->\n                    <tr>\n                        <td style=\"padding: 40px;\">\n                            \n                            <!-- Info Card -->\n                            <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color: #f8fafc; border-radius: 8px; border-right: 4px solid #3B82F6;\">\n                                <tr>\n                                    <td style=\"padding: 25px;\">\n                                        <h2 style=\"color: #1e293b; margin: 0 0 15px 0; font-size: 17px; font-weight: 600;\">פרטי הדוח</h2>\n                                        \n                                        <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n                                            <tr>\n                                                <td style=\"padding: 8px 0; color: #64748b; font-size: 14px; width: 120px;\">מנהל קרן:</td>\n                                                <td style=\"padding: 8px 0; color: #1e293b; font-size: 14px; font-weight: 500;\">{{ $json.managerName }}</td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding: 8px 0; color: #64748b; font-size: 14px;\">שם הדוח:</td>\n                                                <td style=\"padding: 8px 0; color: #1e293b; font-size: 14px; font-weight: 500;\">{{ $json.fileName }}</td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding: 8px 0; color: #64748b; font-size: 14px;\">תאריך יצירה:</td>\n                                                <td style=\"padding: 8px 0; color: #1e293b; font-size: 14px; font-weight: 500;\">{{ $now.setZone('Asia/Jerusalem').toFormat('dd/MM/yyyy') }}</td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding: 8px 0; color: #64748b; font-size: 14px;\">שעת יצירה:</td>\n                                                <td style=\"padding: 8px 0; color: #1e293b; font-size: 14px; font-weight: 500;\">{{ $now.setZone('Asia/Jerusalem').toFormat('HH:mm') }}</td>\n                                            </tr>\n                                        </table>\n                                    </td>\n                                </tr>\n                            </table>\n                            \n                            <!-- Transaction Samples Section (if available) -->\n                            {{ $json.transactionSamples && $json.transactionSamples.length > 0 ? `\n                            <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-top: 25px; background-color: #fefce8; border-radius: 8px; border-right: 4px solid #eab308;\">\n                                <tr>\n                                    <td style=\"padding: 25px;\">\n                                        <h2 style=\"color: #1e293b; margin: 0 0 15px 0; font-size: 17px; font-weight: 600;\">דגימות עסקאות לבדיקה ידנית</h2>\n                                        <p style=\"color: #64748b; font-size: 13px; margin: 0 0 15px 0;\">עסקאות אלו נבחרו באקראי לבדיקה ידנית (בדיקה #5)</p>\n                                        <p style=\"color: #1e293b; font-size: 14px; margin: 0;\">מספר דגימות: ${$json.transactionSamples.length}</p>\n                                    </td>\n                                </tr>\n                            </table>\n                            ` : '' }}\n                            \n                            <!-- Attachment Notice -->\n                            <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-top: 25px;\">\n                                <tr>\n                                    <td style=\"background-color: #eff6ff; border-radius: 8px; padding: 18px 20px; text-align: center;\">\n                                        <span style=\"color: #3b82f6; font-size: 18px; margin-left: 8px;\">&#128206;</span>\n                                        <span style=\"color: #1e40af; font-size: 14px;\">הדוח המלא מצורף למייל זה כקובץ Excel</span>\n                                    </td>\n                                </tr>\n                            </table>\n                            \n                            <!-- Checks Summary -->\n                            <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-top: 25px;\">\n                                <tr>\n                                    <td style=\"background-color: #f0fdf4; border-radius: 8px; padding: 18px 20px;\">\n                                        <p style=\"color: #166534; font-size: 14px; margin: 0; font-weight: 500;\">בדיקות שבוצעו:</p>\n                                        <ul style=\"color: #166534; font-size: 13px; margin: 10px 0 0 0; padding-right: 20px;\">\n                                            <li>בדיקה #1: עסקאות בין-קרנות</li>\n                                            <li>בדיקה #3: תאריכים בטווח חודש הדיווח</li>\n                                            <li>בדיקה #4: כללי אופן החלטה</li>\n                                            <li>בדיקה #5: דגימות לבדיקה ידנית</li>\n                                            <li>בדיקה #6: השוואת מחירים לבורסה</li>\n                                            <li>בדיקה #7: ניירות ערך בעייתיים</li>\n                                        </ul>\n                                    </td>\n                                </tr>\n                            </table>\n                            \n                        </td>\n                    </tr>\n                    \n                    <!-- Footer -->\n                    <tr>\n                        <td style=\"background-color: #f8fafc; padding: 20px 40px; text-align: center; border-top: 1px solid #e2e8f0;\">\n                            <p style=\"margin: 0; color: #94a3b8; font-size: 12px;\">\n                                Powered by <a href=\"https://82labs.com\" target=\"_blank\" style=\"color: #64748b; text-decoration: none; font-weight: 600;\">82Labs</a>\n                            </p>\n                        </td>\n                    </tr>\n                    \n                </table>\n                \n            </td>\n        </tr>\n    </table>\n    \n</body>\n</html>"
      },
